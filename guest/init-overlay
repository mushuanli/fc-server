#!/bin/busybox sh
# Boot a shared read-only DAX root with a private ext4 upper layer.
set -eu
export PATH=/bin
/bin/busybox --install -s /bin
fail() { echo "[init-overlay] result=failed stage=$1" >&2; reboot -f; exit 1; }
mkdir -p /dev /proc /sys /lower /upper /newroot
mount -t devtmpfs devtmpfs /dev
mount -t proc proc /proc
mount -t sysfs sysfs /sys
trap 'fail bootstrap' EXIT
count=0
while [ ! -b /dev/pmem0 ] || [ ! -b /dev/vda ]; do
    count=$((count + 1))
    [ "$count" -lt 100 ] || fail devices
    sleep 0.1
done
mount -t ext4 -o ro,noload,dax=always /dev/pmem0 /lower
mount -t ext4 -o rw,noatime /dev/vda /upper
mkdir -p /upper/upper /upper/work
mount -t overlay overlay -o lowerdir=/lower,upperdir=/upper/upper,workdir=/upper/work /newroot
mkdir -p /newroot/.mindos/lower /newroot/.mindos/upper
mount --move /lower /newroot/.mindos/lower
mount --move /upper /newroot/.mindos/upper
mount --move /dev /newroot/dev
mount --move /proc /newroot/proc
mount --move /sys /newroot/sys
echo '[init-overlay] result=success base=pmem0 mode=ro,dax=always upper=vda'
trap - EXIT
exec switch_root /newroot /sbin/init
